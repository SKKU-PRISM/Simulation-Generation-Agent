# OpenAI API (primary — IsaacLab LLM + VLM Judge)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1/
# OPENAI_MODEL=gpt-5

# Isaac Sim Pipeline — VLM Evaluation (optional)
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GOOGLE_API_KEY=your-google-key-here

# VLM Model Overrides (optional)
# CLAUDE_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=llava:7b
# OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI (legacy — uncomment if using Azure instead of OpenAI direct)
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# AZURE_OPENAI_MODEL=gpt-5
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# HuggingFace (optional — for dataset upload)
# HF_TOKEN=your-hf-token-here

# Paths (override config defaults)
# ISAACLAB_PATH=/path/to/IsaacLab

# Token usage tracking (optional — set to collect API usage across pipeline runs)
# TOKEN_USAGE_FILE=outputs/token_usage.jsonl
# TOKEN_USAGE_LOG=1  # Real-time console log output
